    <comp loc="(500,200)" name="mux8_1">
      <a name="appearance" val="logisim_evolution"/>
    </comp>
  </circuit>
  <vhdl name="mux8_1">
library ieee;
use ieee.std_logic_1164.all;

entity mux8_1 is
    port (
        d   : in std_logic_vector(7 downto 0);
        sel : in std_logic_vector(2 downto 0);
        y   : out std_logic
    );
end entity mux8_1;

architecture bhv of mux8_1 is
begin
    process(d, sel)
    begin
        case sel is
            when "000" =&gt; y &lt;= d(0);
            when "001" =&gt; y &lt;= d(1);
            when "010" =&gt; y &lt;= d(2);
            when "011" =&gt; y &lt;= d(3);
            when "100" =&gt; y &lt;= d(4);
            when "101" =&gt; y &lt;= d(5);
            when "110" =&gt; y &lt;= d(6);
            when "111" =&gt; y &lt;= d(7);
            when others =&gt; y &lt;= '0';
        end case;
    end process;
end architecture bhv;

